# Security, on every response. The Content-Security-Policy is finished at build time by
# integrations/security-headers.mjs: it fills in the hashes of the pages' inline scripts and the
# booking backend's origin. Third parties allowed: the hero's HLS stream (b-cdn.net). Inline
# style attributes are allowed (the design export uses them throughout).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{INLINE_SCRIPT_HASHES}}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob: https://vz-4464ccc5-748.b-cdn.net; connect-src 'self' https://vz-4464ccc5-748.b-cdn.net {{BOOKING_API_ORIGINS}}; worker-src 'self' blob:; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photography and video change rarely; a month. Not immutable: the names are not hashed.
/assets/*
  Cache-Control: public, max-age=2592000
# Fonts keep their names when the licensed files replace the trial ones, so a month, not a year.
/fonts/*
  Cache-Control: public, max-age=2592000
