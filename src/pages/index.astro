---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Intro from '../components/home/Intro.astro';
import Trail from '../components/home/Trail.astro';
import EveningFacts from '../components/home/EveningFacts.astro';
import SharedTable from '../components/home/SharedTable.astro';
import Price from '../components/home/Price.astro';
import Nir from '../components/home/Nir.astro';
import Faq from '../components/home/Faq.astro';
import Footer from '../components/chrome/Footer.astro';
import { getHome, getSite } from '../lib/content';
import { faqLd, restaurantLd } from '../lib/structured-data';

const [home, site] = await Promise.all([getHome(), getSite()]);
---
<Base page="home" seo={home.seo} tone="cream" intro>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(restaurantLd(site))} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd(home.faq.items))} />

  <div style="position:relative;background:#000;min-height:100vh">
    <Hero />
    <!-- The paper sheet that slides over the hero. It turns to charcoal after the trail (systems/trail.ts). -->
    <div data-sheet data-tone-flip class="dao-paper" data-theme="light" style="position:relative;z-index:2;overflow-x:clip;color:var(--ink);transition:background-color 1.25s cubic-bezier(.16,1,.3,1),color 1.25s cubic-bezier(.16,1,.3,1)">
      <Intro />
      <Trail />
      <EveningFacts />
      <SharedTable>
        <Price />
        <Nir />
        <Faq />
        <Footer current="home" tall />
      </SharedTable>
    </div>
  </div>
</Base>
