---
import MaskImage from '../ui/MaskImage.astro';
import { getStory } from '../../lib/content';

const { morning } = await getStory();
---
<section data-screen-label="Morning" data-container class="g12" style="padding:0 64px 200px;align-items:start">
  <figure style="grid-column:1 / span 6;margin:0;display:flex;flex-direction:column;gap:16px">
    <MaskImage image={morning.image} aspect="644 / 800" />
    <figcaption data-reveal-soft data-split="softlines" style="font:400 12px/1.5 var(--font-body);color:var(--ink-2);max-width:340px">{morning.caption}</figcaption>
  </figure>
  <div style="grid-column:8 / span 5;display:flex;flex-direction:column;gap:56px;margin-top:18%">
    <h2 data-reveal-soft data-split="softlines" style="margin:0;font:300 clamp(32px,3vw,48px)/1.1 var(--font-display);letter-spacing:-.02em;color:var(--ink);max-width:none;text-wrap:pretty">{morning.heading}</h2>
    {morning.paragraphs.map((text) => (
      <p data-reveal-soft data-split="softlines" data-measure="m" style="margin:0;font:400 15px/1.6 var(--font-body);color:var(--ink-2);max-width:none;text-wrap:pretty">{text}</p>
    ))}
    <figure data-fig-small style="margin:0;width:70%;display:flex;flex-direction:column;gap:16px">
      <MaskImage image={morning.detail.image} aspect="4 / 3" />
      <figcaption data-reveal-soft data-split="softlines" style="font:400 12px/1.5 var(--font-body);color:var(--ink-2);max-width:300px">{morning.detail.caption}</figcaption>
    </figure>
  </div>
</section>
