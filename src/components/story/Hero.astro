---
import { getStory } from '../../lib/content';

const { hero } = await getStory();
---
<section data-screen-label="Hero" data-hero data-entrance="photo" data-recede-panel="[data-sheet]" data-recede-scale="0.88" data-recede-y="24" style="position:sticky;top:0;z-index:1;height:100vh;min-height:640px;overflow:hidden;color:var(--paper);transform-origin:50% 50%">
  <div data-hero-mask style="position:absolute;inset:0;overflow:hidden">
    <img data-hero-img src={hero.image.src} alt={hero.image.alt} decoding="async" fetchpriority="high" style={`position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:${hero.image.position ?? '50% 50%'};display:block`} />
    <span style="position:absolute;inset:0;background:var(--scrim-floor)"></span>
    <span style="position:absolute;inset:0;background:var(--scrim-band)"></span>
    <span style="position:absolute;left:0;right:0;top:0;height:160px;background:linear-gradient(180deg,rgba(0,0,0,.28),transparent)"></span>
  </div>
  <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:32px;padding:0 24px;text-align:center">
    <h1 data-hero-title style="max-width:820px;font:300 clamp(40px,4.45vw,64px)/1.2 var(--font-display);letter-spacing:-.02em;color:var(--paper);margin:0">
      {hero.lines.map((line, i) => <>{i > 0 && ' '}<span data-hero-line style="display:block">{line}</span></>)}
    </h1>
  </div>
  <span data-hero-corner style="position:absolute;right:64px;bottom:40px;font:500 10px/1 var(--font-body);letter-spacing:.22em;text-transform:uppercase;color:rgba(247,244,236,.6)">{hero.corner}</span>
  <span data-recede-dim style="position:absolute;inset:0;background:#000;opacity:0;pointer-events:none"></span>
</section>
