---
/**
 * The sheet a page transition draws over the screen. Filled per navigation by core/transition.ts,
 * which takes a destination's name from the menu, or for a page outside it from the list here.
 */
import { getSite } from '../../lib/content';

const site = await getSite();
---
<div data-pt-panel class="pt dao-paper" data-theme="dark" aria-hidden="true">
  <div class="pt__wrap">
    <p data-pt-name class="pt__name"></p>
    <p data-pt-num class="pt__num"></p>
  </div>
</div>
<ul hidden>
  {site.unlisted.map((p) => <li data-pt-page data-href={p.href} data-name={p.label}></li>)}
</ul>
<div data-route-announcer class="sr-only" aria-live="polite" aria-atomic="true"></div>
