---
/**
 * The same close on every page: the four pages as frames, then reserve, contact and place.
 */
import Cta from '../ui/Cta.astro';
import Picture from '../ui/Picture.astro';
import { getSite, pageHref } from '../../lib/content';
import type { PageKey } from '../../content/types';

interface Props {
  current: PageKey;
  /** Home closes on a full screen with generous space above. */
  tall?: boolean;
}

const { current, tall = false } = Astro.props;
const site = await getSite();
const { email, phone, area } = site.contact;
---
<footer role="contentinfo" data-screen-label="Reserve and footer" data-container class:list={['footer', tall && 'footer--tall']}>
  <div data-footer-strip class="footer__strip">
    {site.pages.map((p) => (
      <a href={p.href} data-footer-page class="footer__page" aria-current={p.key === current ? 'page' : undefined}>
        <span data-mask data-parallax class="footer__mask"><span data-zoom class="footer__zoom"><Picture image={p.image} alt="" sizes="(max-width: 820px) 107vw, 56vw" loading="lazy" /></span></span>
        <span class="footer__meta"><span class="footer__name">{p.label}</span><span class="footer__num dao-num" aria-hidden="true">{p.num}</span></span>
      </a>
    ))}
  </div>
  <div data-reveal-soft data-split="none" class="footer__bar">
    <div class="footer__cta"><Cta label={site.labels.reserve} href={pageHref('reserve')} /></div>
    <div class="footer__contact">
      <a href={`mailto:${email}`}>{email}</a>
      <a href={`tel:${phone.replace(/\s/g, '')}`} class="dao-num">{phone}</a>
    </div>
    <div class="footer__place"><span>{area}</span><span>{site.copyright}</span></div>
  </div>
</footer>
