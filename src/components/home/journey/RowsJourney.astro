---
/**
 * The day before dinner, "rows" (the version in use; the alternative is SpineJourney.astro).
 *
 * Desktop: two full-width rows of photographs at mixed widths, held on screen while the page scrolls
 * through the section; the scroll carries both rows sideways at different speeds, each going round
 * seamlessly. The lower row is timed so the evening section's photograph arrives in the middle as
 * the hold ends; it is then lifted off and grows into that section's own. After a reference
 * (a scroll grid, three rows there). Driven by systems/journey/rows.ts.
 *
 * Phones: the same photographs in two plain, slightly staggered columns. Nothing held, nothing carried.
 */
import Picture from '../../ui/Picture.astro';
import { getHome } from '../../../lib/content';

const { lead, photos } = (await getHome()).rows;
const rows = [photos.filter((_, i) => i % 2 === 0), photos.filter((_, i) => i % 2 === 1)];
// tile widths, as a share of the row height: a quiet rhythm of wide, upright and square
const widths = [1.5, 0.8, 1.15, 1.5, 0.95, 1.3, 0.8];
---
<section data-screen-label="Rows" data-rows class="jr-rows" aria-label="The day before dinner">
  <div class="jr-rows__head">
    <p class="jr-lead" data-reveal-soft data-split="softlines">{lead}</p>
  </div>

  <div class="jr-rows__stage" data-only="desktop">
    {rows.map((row, r) => (
      <div class="jr-rows__row" data-rows-row data-speed={r ? '1.45' : '1'}>
        <div class="jr-rows__track" data-rows-track>
          {[0, 1].map((copy) => (
            <ul class="jr-rows__set" aria-hidden={copy ? 'true' : undefined}>
              {row.map((p, k) => (
                <li class="jr-rows__tile" style={`--w:${widths[(k + r * 3) % widths.length]}`}>
                  <Picture image={p} alt={copy ? '' : p.alt} sizes="62vh" loading="lazy" />
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="jr-rows__cols" data-only="mobile">
    {rows.map((col) => (
      <ul class="jr-rows__col">
        {col.map((p, k) => (
          <li class:list={['jr-rows__pic', { 'is-tall': k % 2 === 0 }]} data-block>
            <Picture image={p} sizes="80vw" loading="lazy" />
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>
