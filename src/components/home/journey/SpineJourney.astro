---
/**
 * The day before dinner, "the spine".
 *
 * Desktop: the day's photographs as one tight column that bends along a slow wave as it scrolls
 * past, with the moment it belongs to held beside it (the time rolls, label and sentence
 * change in place). The last photograph grows into the evening section's own.
 * Driven by systems/journey/spine.ts.
 *
 * Phones: the moment above a row of photographs swiped sideways, one card per swipe.
 * Driven by systems/journey/spine-mobile.ts. Only the layout for the current device stays in the
 * page (data-only, removed by systems/device-only.ts). Both open in the site's language as they
 * scroll in (journey/shared.ts revealIn).
 *
 * The visible copy beside the photographs changes as they pass, so it is hidden from screen
 * readers; the list of moments is read instead.
 */
import Picture from '../../ui/Picture.astro';
import { getHome } from '../../../lib/content';
import { scriptJson } from '../../../lib/json';

const { moments } = (await getHome()).journey;
const frames = moments.flatMap((m, i) => m.ribbon.map((r) => ({ ...r, moment: i })));
const json = scriptJson(moments.map(({ time, label, text }) => ({ time, label, text })));
---
<section data-screen-label="Spine" data-spine class="jr-spine" aria-label="The day before dinner">
  <ol class="sr-only">
    {moments.map((m) => <li>{m.time}, {m.label}. {m.text}</li>)}
  </ol>
  <script type="application/json" data-spine-moments set:html={json} />

  <div class="jr-spine__body" data-only="desktop">
    <div class="jr-spine__copy" data-spine-copy data-spine-in aria-hidden="true">
      <p class="jr-big" data-spine-time>{moments[0].time}</p>
      <p class="jr-meta jr-roll" data-spine-label><span>{moments[0].label}</span></p>
      <p class="jr-text jr-swap" data-spine-text><span>{moments[0].text}</span></p>
    </div>
    <div class="jr-spine__ribbon">
      <div class="jr-spine__axis" data-spine-axis aria-hidden="true"></div>
      {frames.map((f) => (
        <figure data-spine-item data-spine-reveal data-moment={f.moment} class:list={['jr-spine__frame', { 'is-tall': f.tall }]}>
          <Picture image={f} sizes="30vw" loading="lazy" />
        </figure>
      ))}
    </div>
  </div>

  <div class="jr-swipe" data-spine-swipe data-only="mobile">
    <div class="jr-swipe__copy" data-ms-copy data-spine-in aria-hidden="true">
      <p class="jr-big" data-ms-time>{moments[0].time}</p>
      <p class="jr-meta jr-roll" data-ms-label><span>{moments[0].label}</span></p>
      <p class="jr-text jr-swap" data-ms-text><span>{moments[0].text}</span></p>
    </div>
    <ul class="jr-swipe__rail" data-ms-rail tabindex="0" aria-label="Photographs of the day, swipe for more">
      {moments.map((m) => (
        <li class="jr-swipe__card" data-ms-card data-spine-reveal>
          <Picture image={m.image} sizes="135vw" loading="lazy" />
        </li>
      ))}
    </ul>
    <div class="jr-swipe__bar" aria-hidden="true">
      {moments.map(() => <button type="button" tabindex="-1" data-ms-dot><span></span></button>)}
    </div>
  </div>
</section>
