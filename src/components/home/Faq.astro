---
/**
 * Questions: the few most asked (picked from the info page's, content/home.ts), then the way to
 * all of them on the info page, which is in neither the menu nor the footer.
 */
import Cta from '../ui/Cta.astro';
import FaqList from '../ui/FaqList.astro';
import { getHome, getSite } from '../../lib/content';
import { fillAnswers } from '../../lib/faq';

const [{ faq }, site] = await Promise.all([getHome(), getSite()]);
const items = fillAnswers(faq.items, site);
---
<section data-screen-label="FAQ" data-container class="g12" aria-labelledby="faq-h" style="padding:120px 64px 200px;box-sizing:border-box;align-items:start;--fq-ink:var(--cream-bright)">
  <h2 id="faq-h" data-reveal-soft data-split="softlines" style="grid-column:2 / span 3;position:sticky;top:140px;align-self:start;margin:0;font:300 clamp(36px,3.6vw,56px)/1.05 var(--font-display);letter-spacing:-.02em;color:var(--cream-bright);max-width:none;text-wrap:pretty">{faq.heading}</h2>
  <div style="grid-column:5 / span 8;display:flex;flex-direction:column">
    <FaqList items={items} idPrefix="faq" />
    <div data-reveal-soft data-split="none" data-faq-more style="margin-top:56px"><Cta label={faq.more.label} href={faq.more.href} /></div>
  </div>
</section>
