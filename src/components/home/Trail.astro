---
/**
 * The day before dinner, as a sideways walk. On desktop the section pins and the
 * frames travel left with the scroll, each frame's height, opening and zoom driven by
 * its distance from a line at 40% of the screen (systems/trail.ts). On phones it runs
 * vertically as two overlapping columns (styles/pages/home.css).
 *
 * The two sentences sit under / over a chosen frame. Their positions are computed from
 * the frame sizes below, so frames can change in content without re-measuring by hand.
 */
import { getHome } from '../../lib/content';

const home = await getHome();
const { frames, texts } = home.trail;

// Layout: a frame is `height`vh tall at 3:4, frames are 3vw apart, the track starts 64px in.
const GAP_VW = 3;
const widthVh = (h: number) => h * 0.75;
const centreVh = (i: number) => frames.slice(0, i).reduce((sum, f) => sum + widthVh(f.height), 0) + widthVh(frames[i].height) / 2;
const TEXT_W_VW = 26;
const left = (i: number) => `calc(64px + ${centreVh(i).toFixed(1)}vh + ${i * GAP_VW}vw - ${TEXT_W_VW / 2}vw)`;
// Frames are centred vertically, then shifted by their offset.
const frameTop = (i: number) => 50 - frames[i].height / 2 + frames[i].offset;
const frameBottom = (i: number) => 50 + frames[i].height / 2 + frames[i].offset;

// First sentence hangs under the fifth frame, the second stands over the eighth.
const anchors = [
  { at: 4, style: (i: number) => `left:${left(i)};top:calc(${frameBottom(i)}vh + 10vh)` },
  { at: 7, style: (i: number) => `left:${left(i)};bottom:calc(${100 - frameTop(i)}vh + 10vh)` },
];
const textStyle = `position:absolute;margin:0;width:${TEXT_W_VW}vw;min-width:320px;max-width:none;font:300 clamp(22px,1.9vw,28px)/1.3 var(--font-display);letter-spacing:-.01em;color:var(--ink);text-wrap:pretty`;
---
<section data-screen-label="Trail" data-trail style="position:relative;height:100vh;overflow:hidden">
  <div data-track style="position:relative;display:flex;align-items:center;gap:3vw;height:100vh;width:max-content;padding:0 8vw 0 64px;box-sizing:border-box;will-change:transform">
    {frames.map((f) => (
      <div data-tmask data-side={f.side} data-off={f.offset} style={`position:relative;flex:0 0 auto;height:${f.height}vh;aspect-ratio:3 / 4;overflow:hidden;align-self:center`}>
        <img src={f.src} alt={f.alt} decoding="async" style={`position:absolute;inset:0 -8%;width:116%;height:100%;object-fit:cover;object-position:${f.position ?? '50% 50%'};display:block`} />
      </div>
    ))}
    {texts.map((text, n) => (
      <p data-trail-text data-split="softlines" style={`${textStyle};${anchors[n].style(anchors[n].at)}`}>{text}</p>
    ))}
  </div>
</section>
