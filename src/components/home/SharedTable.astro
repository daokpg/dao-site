---
/**
 * The night section. The photograph holds still and settles back while the dark sheet
 * after it slides over (systems/recede.ts). Everything after it goes in the slot, which
 * is that dark sheet.
 */
import { getHome } from '../../lib/content';

const { sharedTable } = await getHome();
const { image } = sharedTable;
---
<div data-void style="position:relative;background:#000">
  <section data-screen-label="The shared table" data-recede data-recede-panel="[data-over]" data-recede-scale="0.86" data-recede-y="16" class="dao-paper" data-theme="dark" style="position:sticky;top:0;z-index:1;height:100vh;min-height:640px;overflow:hidden;color:var(--ink-on-image);transform-origin:50% 50%;background:#15130F">
    <div data-mask data-parallax style="position:absolute;inset:0;overflow:hidden">
      <img src={image.src} alt={image.alt} loading="lazy" decoding="async" style={`position:absolute;inset:-8% 0;width:100%;height:116%;object-fit:cover;object-position:${image.position ?? '50% 50%'};display:block`} />
      <span style="position:absolute;inset:0;background:var(--scrim-floor)"></span>
      <span style="position:absolute;inset:0;background:var(--scrim-band)"></span>
    </div>
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:0 64px">
      <p data-reveal-soft data-split="softlines" data-measure="m" style="width:min(760px,80vw);margin:0;text-align:center;font:300 clamp(26px,2.6vw,38px)/1.3 var(--font-display);letter-spacing:-.01em;color:var(--ink-on-image);max-width:none;text-wrap:pretty">{sharedTable.text}</p>
    </div>
    <span data-corner style="position:absolute;right:64px;bottom:40px;font:500 10px/1 var(--font-body);letter-spacing:.22em;text-transform:uppercase;color:var(--meta-on-image)">{sharedTable.corner}</span>
    <span data-recede-dim style="position:absolute;inset:0;background:#000;opacity:0;pointer-events:none"></span>
  </section>

  <div data-over class="dao-paper" data-theme="dark" style="position:relative;z-index:2;background:#15130F">
    <slot />
  </div>
</div>
