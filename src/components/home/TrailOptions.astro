---
/**
 * The day before dinner. The spine is the version in use (the client's choice); Rows is kept for
 * now, shown with ?trail=rows (systems/trail-variant.ts keeps one and removes the other
 * before anything else runs). The original wave trail is archived in git: tag archive/wave-trail.
 */
import RowsJourney from './journey/RowsJourney.astro';
import SpineJourney from './journey/SpineJourney.astro';
---
<div data-trail-variant="rows"><RowsJourney /></div>
<div data-trail-variant="spine"><SpineJourney /></div>
