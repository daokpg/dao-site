---
import Cta from '../ui/Cta.astro';
import MaskImage from '../ui/MaskImage.astro';
import { getHome } from '../../lib/content';

const { nir } = await getHome();
---
<section data-screen-label="Nir" data-container class="g12" style="padding:120px 64px 200px;align-items:start" aria-labelledby="nir-h">
  <h2 id="nir-h" data-reveal-soft data-split="softlines" style="grid-column:4 / span 6;justify-self:center;margin:0 0 48px;text-align:center;font:300 clamp(28px,2.8vw,40px)/1.15 var(--font-display);letter-spacing:-.01em;color:var(--ink);max-width:none">{nir.name}</h2>
  <MaskImage image={nir.image} aspect="3 / 4" style="grid-column:5 / span 4" sizes="(max-width: 820px) 100vw, 34vw" />
  <p data-reveal-soft data-split="softlines" data-measure="m" style="grid-column:4 / span 6;margin:40px 0 0;text-align:center;font:300 clamp(20px,1.8vw,26px)/1.45 var(--font-display);justify-self:center;letter-spacing:-.01em;color:var(--ink-2);max-width:none;text-wrap:pretty">{nir.text}</p>
  <div data-reveal-soft data-split="none" style="grid-column:4 / span 6;display:flex;justify-content:center;margin-top:32px"><Cta label={nir.cta.label} href={nir.cta.href} /></div>
</section>
