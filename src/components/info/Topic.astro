---
/** One topic of the info page: its name held beside its questions while they pass, as on the home page. */
import FaqList from '../ui/FaqList.astro';
import type { FaqItem } from '../../content/types';
import { pad2 } from '../../lib/format';

interface Props {
  topic: { id: string; title: string; items: FaqItem[] };
  num: number;
}

const { topic, num } = Astro.props;
---
<section id={topic.id} data-screen-label={topic.title} data-container class="g12 info-topic" aria-labelledby={`${topic.id}-h`}>
  <div class="info-topic__head">
    <span class="info-topic__num dao-num" aria-hidden="true">{pad2(num)}</span>
    <h2 id={`${topic.id}-h`} data-reveal-soft data-split="softlines" class="info-topic__title">{topic.title}</h2>
  </div>
  <FaqList items={topic.items} style="grid-column:5 / span 8" />
</section>
