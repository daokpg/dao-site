---
/**
 * A photograph in a frame that opens from its bottom centre when scrolled to, with the
 * picture drifting inside the frame (in-frame parallax). The frame's aspect ratio is
 * layout, the image and its crop are content.
 */
import type { Image } from '../../content/types';
import { cropStyle } from '../../lib/format';

interface Props {
  image: Image;
  aspect: string;
  /** Extra inline style for the frame (grid placement and the like). */
  style?: string;
}

const { image, aspect, style = '' } = Astro.props;
---
<div data-mask data-parallax style={`position:relative;aspect-ratio:${aspect};overflow:hidden;${style}`}>
  <img class="img" src={image.src} alt={image.alt} style={cropStyle(image.position)} loading="lazy" decoding="async" />
</div>
