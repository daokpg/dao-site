---
/**
 * The site's call to action: a tracked label whose letters roll on hover, over a
 * hairline that retracts and regrows. A link when given `href`, otherwise a button.
 */
import type { HTMLAttributes } from 'astro/types';
import Letters from './Letters.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  label: string;
  href?: string;
  /** Extra attributes for the label and the rule, used by the hero entrance. */
  labelAttrs?: Record<string, string | boolean>;
  ruleAttrs?: Record<string, string | boolean>;
}

const { label, href, labelAttrs = {}, ruleAttrs = {}, class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag
  href={href}
  type={href ? undefined : ('button' as const)}
  class:list={['lt-host', 'cta', cls]}
  aria-label={label}
  {...rest}
>
  <span class="lt" {...labelAttrs}><span class="a" aria-hidden="true"><Letters text={label} /></span><span class="b" aria-hidden="true"><Letters text={label} /></span></span>
  <span class="rl" {...ruleAttrs}><span class="l"></span><span class="r"></span><span class="c"></span></span>
</Tag>
