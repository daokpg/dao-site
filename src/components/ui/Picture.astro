---
/**
 * A photograph with its WebP copies (`name-800.webp`, `name-1600.webp`, written next to the JPEG by
 * `npm run photos` and listed in lib/photo-variants.json): one srcset of the copies and, where no
 * copy is at its own width, the original JPEG at that width; the browser picks by `sizes`. It sits
 * in a <picture> so scripts can move the picture without touching the <img>. A photograph without
 * copies is the plain <img>. Extra attributes go on the <img>.
 *
 * `defer` renders it without its files (data-srcset / data-src): a script fetches them when they
 * are wanted (loadDeferred in scripts/core/defer.ts), as the menu and the hover rows do.
 */
import type { HTMLAttributes } from 'astro/types';
import type { Image } from '../../content/types';
import { cropStyle } from '../../lib/format';
import variants from '../../lib/photo-variants.json';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'sizes' | 'style'> {
  image: Image;
  /** The width the picture is drawn at, as for <source sizes>. */
  sizes: string;
  defer?: boolean;
}

const { image, sizes, defer = false, alt = image.alt, decoding = 'async', ...attrs } = Astro.props;

const entry = (variants as Record<string, { width: number; webp: number[] }>)[image.src];
const files = entry ? entry.webp.map((w) => `${image.src.replace(/\.jpe?g$/i, '')}-${w}.webp ${w}w`) : [];
if (entry && !entry.webp.includes(entry.width)) files.push(`${image.src} ${entry.width}w`);
const srcset = files.join(', ');
const file = defer ? { 'data-srcset': srcset, 'data-src': image.src } : { srcset, src: image.src };
---
{srcset ? (
  <picture>
    <img {...file} sizes={sizes} alt={alt} style={cropStyle(image.position)} decoding={decoding} {...attrs} />
  </picture>
) : (
  <img src={defer ? undefined : image.src} data-src={defer ? image.src : undefined} alt={alt} style={cropStyle(image.position)} decoding={decoding} {...attrs} />
)}
