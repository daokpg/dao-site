---
/**
 * Every page renders inside this. Two zones:
 *  - Persistent chrome (loader, nav, menu, transition sheet) sits OUTSIDE the
 *    Barba container and lives for the whole visit.
 *  - The page itself is the Barba container (<main>), swapped on every navigation.
 * Anything inside <main> that needs JS must go through the registry (src/scripts/core/registry.ts).
 */
import '../styles/tokens/fonts.css';
import '../styles/tokens/colors.css';
import '../styles/tokens/typography.css';
import '../styles/tokens/spacing.css';
import '../styles/tokens/grid.css';
import '../styles/tokens/texture.css';
import '../styles/tokens/motion.css';
import '../styles/tokens/base.css';
import '../styles/global.css';
import '../styles/chrome.css';
import '../styles/pages/home.css';
import '../styles/pages/story.css';
import '../styles/pages/evening.css';
import '../styles/pages/reserve.css';
import '../styles/pages/info.css';

import Loader from '../components/chrome/Loader.astro';
import Nav from '../components/chrome/Nav.astro';
import Menu from '../components/chrome/Menu.astro';
import TransitionSheet from '../components/chrome/TransitionSheet.astro';
import TrailSwitcher from '../components/chrome/TrailSwitcher.astro';
import type { PageKey, Seo } from '../content/types';
import { getSite } from '../lib/content';

interface Props {
  page: PageKey;
  seo: Seo;
  /** Nav tone on arrival: cream over photography or dark ground, ink over paper. */
  tone: 'cream' | 'ink';
  /** Render the intro loader (home only). */
  intro?: boolean;
}

const { page, seo, tone, intro = false } = Astro.props;

// Blocks reveal in small waves: every Nth block restarts the stagger. "N step" per page, as designed.
const blockRhythm = { home: '4 0.08', story: '5 0.08', evening: '6 0.07', reserve: '6 0.07', info: '6 0.07' }[page];
// share previews and the canonical address need absolute URLs (astro.config.mjs `site`)
const site = await getSite();
// pages build to /story.html but live at /story (astro.config.mjs format: 'file')
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/', Astro.site);
const shareImage = new URL(site.shareImage.src, Astro.site);
// search engines only once the real domain is live (INDEXABLE=true at build); staging stays out
// (the not-found page is never indexed and names no canonical address)
const notFound = /\/404(\.html)?$/.test(Astro.url.pathname);
const indexable = import.meta.env.INDEXABLE === 'true' && !notFound;
---
<!doctype html>
<html lang="en" data-nav-tone={tone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {!notFound && <link rel="canonical" href={canonical} />}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={String(site.shareImage.width)} />
    <meta property="og:image:height" content={String(site.shareImage.height)} />
    <meta property="og:image:alt" content={site.shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#15130F" />
    <!-- icons and the manifest: made from the mark by tools/share-images.mjs -->
    <link rel="icon" href="/assets/dao-mark.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/SeasonMixTRIAL-Light.otf" as="font" type="font/otf" crossorigin />
    <!-- Before first paint: mark JS as running so pre-hidden states apply (no-JS visitors see the finished page). -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Which version of the home page's day section to show (the spine; ?trail=rows to see the alternative), remembered for the visit. Remove with Rows. -->
    <script is:inline>try{var t=new URLSearchParams(location.search).get('trail');if(t)sessionStorage.setItem('dao-trail',t);document.documentElement.dataset.trail=sessionStorage.getItem('dao-trail')||'spine';}catch(e){document.documentElement.dataset.trail='spine';}</script>
    <slot name="head" />
  </head>
  <body data-barba="wrapper" data-page={page}>
    <a href="#content" class="skip-link">{site.labels.skip}</a>
    {intro && <Loader />}
    <Nav />
    <Menu />
    <main id="content" tabindex="-1" data-barba="container" data-barba-namespace={page} data-page={page} data-tone={tone} data-block-rhythm={blockRhythm}>
      <slot />
    </main>
    <TransitionSheet />
    {import.meta.env.DEV && <TrailSwitcher />}
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
